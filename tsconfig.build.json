{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/server", "src/compartilhado"],
  // O SMS falso e a entrada de desenvolvimento não existem em produção.
  "exclude": [
    "src/server/**/*.test.ts",
    "src/server/testes",
    "src/server/dev",
    "src/server/sms/sms-falso.ts"
  ]
}
