{
  "name": "passaly",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n servidor,cliente -c blue,magenta \"tsx watch --env-file-if-exists=.env src/server/dev/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "node dist/server/index.js",
    "start:local": "SERVIR_SPA=1 tsx --env-file-if-exists=.env src/server/dev/index.ts",
    "tique": "tsx --env-file-if-exists=.env src/server/dev/tique.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrar.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hono/node-server": "^2.1.9",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "^5.108.1",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "input-otp": "1.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
